#!/usr/bin/env bash
# kitty-fzf: fuzzy find & switch kitty windows (panes) / tabs, like tmux-fzf.
#
# Usage:
#   kitty-fzf            # pick a window (pane) across all OS windows + tabs
#   kitty-fzf tab        # pick a tab
#
# Keys inside fzf:
#   enter   focus selection
#   ctrl-x  close selection (window or tab), list reloads
#   ctrl-r  reload list
#   ctrl-/  toggle preview
#
# Requires: kitty remote control (allow_remote_control yes + listen_on), fzf, jq.
# kitty.conf mapping (runs as an overlay over the current window):
#   map ctrl+shift+space launch --type=overlay --allow-remote-control /path/to/kitty-fzf
#   map ctrl+shift+t     launch --type=overlay --allow-remote-control /path/to/kitty-fzf tab

set -euo pipefail

mode="${1:-window}"
self_id="${KITTY_WINDOW_ID:-0}"
self="$(realpath "$0")"

kc() { kitty @ "$@"; }

for bin in kitty fzf jq; do
  command -v "$bin" >/dev/null || { echo "kitty-fzf: missing $bin" >&2; exit 1; }
done

# Optional bigger font for the picker. Only set this when kitty-fzf runs in its own
# OS window (os-panel / os-window): kitty font size is per OS window.
#   map ... launch --type=os-panel --env KITTY_FZF_FONT_SIZE=14 ... kitty-fzf
if [[ -n ${KITTY_FZF_FONT_SIZE:-} && $mode != --list-* ]]; then
  kc set-font-size "$KITTY_FZF_FONT_SIZE" 2>/dev/null || true
fi

list_windows() {
  # id <TAB> display ("tab › title") <TAB> cwd <TAB> cmd  (cwd/cmd only shown in preview label)
  kc ls | jq -r --argjson self "$self_id" '
    def short: sub("^" + env.HOME; "~");
    .[] | .tabs[] as $t | $t.windows[]
    | select(.id != $self)
    | (.foreground_processes[-1].cmdline // [] | map(split("/")[-1]) | join(" ") | .[0:60]) as $cmd
    | [ (.id|tostring),
        "\u001b[36m\($t.title)\u001b[0m \u001b[2m›\u001b[0m "
          + (if .is_focused then "\u001b[33m*\u001b[0m" else "" end) + .title,
        (.cwd|short),
        $cmd ] | join("\t")'
}

list_tabs() {
  kc ls | jq -r --argjson self "$self_id" '
    to_entries[] | .key as $os | .value.tabs[]
    | ([.windows[] | select(.id != $self)] | length) as $n
    | select($n > 0)
    | [ (.id|tostring),
        "\($os+1)",
        (if .is_focused then "*" else " " end) + .title,
        "\($n) panes" ] | join("\t")'
}

case "$mode" in
  window|pane|w|p)
    list_cmd="$self --list-windows"
    preview='kitty @ get-text --ansi --match id:{1} | tail -n "$FZF_PREVIEW_LINES"'
    focus_cmd() { kc focus-window --match "id:$1"; }
    close_cmd="kitty @ close-window --match id:{1}"
    header="enter: focus  ctrl-x: close pane  ctrl-r: reload"
    ;;
  tab|t)
    list_cmd="$self --list-tabs"
    preview='kitty @ get-text --ansi --match "id:$(kitty @ ls | jq -r ".[].tabs[] | select(.id=={1}) | (.windows[] | select(.is_focused) | .id) // .windows[0].id" | head -1)" | tail -n "$FZF_PREVIEW_LINES"'
    focus_cmd() { kc focus-tab --match "id:$1"; }
    close_cmd="kitty @ close-tab --match id:{1}"
    header="enter: focus  ctrl-x: close tab  ctrl-r: reload"
    ;;
  --list-windows) list_windows; exit ;;
  --list-tabs)    list_tabs;    exit ;;
  -h|--help) sed -n '2,17p' "$self"; exit ;;
  *) echo "kitty-fzf: unknown mode '$mode' (window|tab)" >&2; exit 2 ;;
esac

choice="$(
  $list_cmd | fzf \
    --delimiter='\t' --with-nth=2 \
    --ansi --reverse --cycle --tabstop=2 \
    --prompt="kitty $mode> " --header="$header" \
    --preview="$preview" --preview-window='right,55%,wrap' \
    --bind="ctrl-x:execute-silent($close_cmd)+reload($list_cmd)" \
    --bind="ctrl-r:reload($list_cmd)" \
    --bind="ctrl-/:toggle-preview" \
    --bind="focus:transform-preview-label:[[ -n {3} ]] && echo ' {3}  ·  {4} '"
)" || exit 0

id="${choice%%$'\t'*}"
[[ -n "$id" ]] && focus_cmd "$id"
